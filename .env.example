# Video Automation Machine - Configuration Template
# Copy this file to .env and fill in your API keys

# LLM Provider (OpenAI-compatible endpoint)
# For NVIDIA API: LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# For OpenAI: LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Video Provider (Pexels)
PEXELS_API_KEY=your_pexels_api_key_here

# Audio Provider (ElevenLabs - optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Default Settings
DEFAULT_VIDEO_DURATION=60
DEFAULT_RESOLUTION=1080x1920
DEFAULT_VIDEO_PROVIDER=pexels
DEFAULT_AUDIO_PROVIDER=edge-tts

# Paths
OUTPUT_DIR=output
TEMP_DIR=temp
LOGS_DIR=logs
